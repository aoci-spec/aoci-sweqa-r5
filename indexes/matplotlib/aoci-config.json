{
  "version": 2,
  "locale": "en-US",
  "index_path": "aoci.txt",
  "exclude_dirs": [
    "node_modules",
    ".next",
    ".output",
    "__pycache__",
    ".venv",
    "venv",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".nox",
    "htmlcov"
  ],
  "exclude_root_dirs": [
    "backup",
    "backups",
    "build",
    "cache",
    "coverage",
    "dist",
    "target",
    "tmp",
    "uploads",
    "artifacts",
    "vendor"
  ],
  "exclude_files": [
    "*.backup.*",
    "*.bak",
    ".coverage"
  ],
  "exclude_exts": [],
  "curation_exclude": [],
  "hook_strict": false,
  "ledger_enabled": true,
  "line_ending_tolerance": true,
  "cognition_refresh_threshold": 30,
  "overview_delivery": {
    "chunk_tokens": 24000
  },
  "managed_scope": {
    "version": "managed-scope-policy/v2",
    "profile": "full",
    "observe_change_policy": "informational",
    "approval_mode": "inherit",
    "approval_thresholds": {
      "entry_removal_count": 25,
      "entry_removal_percent": 25
    },
    "rules": [
      {
        "rule_id": "observe-all",
        "action": "observe",
        "pattern": "**",
        "pattern_kind": "glob",
        "reason": "r5 code-only cognition: non-code files observed",
        "source": "user",
        "created_by": "human",
        "order": 0,
        "enabled": true
      },
      {
        "rule_id": "index-code-10",
        "action": "index",
        "pattern": "**/*.py",
        "pattern_kind": "glob",
        "reason": "r5 code-only cognition: Python/Cython sources incl. tests",
        "source": "user",
        "created_by": "human",
        "order": 10,
        "enabled": true
      },
      {
        "rule_id": "index-code-11",
        "action": "index",
        "pattern": "**/*.pyx",
        "pattern_kind": "glob",
        "reason": "r5 code-only cognition: Python/Cython sources incl. tests",
        "source": "user",
        "created_by": "human",
        "order": 11,
        "enabled": true
      },
      {
        "rule_id": "index-code-12",
        "action": "index",
        "pattern": "**/*.pxd",
        "pattern_kind": "glob",
        "reason": "r5 code-only cognition: Python/Cython sources incl. tests",
        "source": "user",
        "created_by": "human",
        "order": 12,
        "enabled": true
      },
      {
        "rule_id": "index-code-13",
        "action": "index",
        "pattern": "**/*.pyi",
        "pattern_kind": "glob",
        "reason": "r5 code-only cognition: Python/Cython sources incl. tests",
        "source": "user",
        "created_by": "human",
        "order": 13,
        "enabled": true
      },
      {
        "rule_id": "no-agents-md",
        "action": "exclude",
        "pattern": "AGENTS.md",
        "pattern_kind": "file",
        "reason": "init artifact",
        "source": "user",
        "created_by": "human",
        "order": 20,
        "enabled": true
      }
    ]
  },
  "cognition_budget": {
    "version": "cognition-budget-policy/v1",
    "mode": "enforce",
    "whole_index": {
      "target_tokens": 200000,
      "warning_tokens": 300000,
      "max_tokens": 400000
    },
    "r": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 25,
        "max_tokens": 50
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 45,
        "max_tokens": 90
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 90,
        "max_tokens": 180
      }
    ],
    "s": [
      {
        "min_c": 1,
        "max_c": 4,
        "target_tokens": 20,
        "max_tokens": 40
      },
      {
        "min_c": 5,
        "max_c": 7,
        "target_tokens": 40,
        "max_tokens": 80
      },
      {
        "min_c": 8,
        "max_c": 8,
        "target_tokens": 70,
        "max_tokens": 140
      },
      {
        "min_c": 9,
        "max_c": 9,
        "target_tokens": 100,
        "max_tokens": 200
      }
    ]
  },
  "installed_agents": [],
  "automation": {
    "mode": "auto"
  },
  "ai": {
    "enabled": false,
    "provider": "openai-compatible",
    "base_url": "",
    "model": "",
    "api_key_env": "",
    "timeout_seconds": 0,
    "max_concurrency": 0,
    "max_input_tokens": 0,
    "token_accounting": "auto",
    "prompt_snapshot": "redacted"
  }
}
